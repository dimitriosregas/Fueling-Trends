// worker.js
import { connect } from 'cloudflare:sockets';

export default {
  // 1. Handle HTTP requests (Receiving PDFs & Serving Dashboard Data)
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // Route: Receive PDF data from Google Apps Script
    if (request.method === "POST" && url.pathname === "/upload-pdf") {
      const data = await request.json();
      console.log(`Received PDF: ${data.filename} from ${data.date}`);
      
      // Store in Cloudflare KV database
      await env.INVENTORY_DB.put("latest_invoice", JSON.stringify(data));
      
      return new Response("PDF received and logged.", { status: 200 });
    }

    // Route: Serve Data to your HTML5 Dashboard
    if (request.method === "GET" && url.pathname === "/api/inventory-status") {
      // Retrieve the latest scraped data for all sites
      const shellData = await env.INVENTORY_DB.get("current_status_Shell") || '{"status": "No data"}';
      const exxonData = await env.INVENTORY_DB.get("current_status_Exxon") || '{"status": "No data"}';
      const xpressData = await env.INVENTORY_DB.get("current_status_Xpress") || '{"status": "No data"}';
      
      const combinedData = {
        Regas_Shell: JSON.parse(shellData),
        Regas_Exxon: JSON.parse(exxonData),
        Regas_Xpress: JSON.parse(xpressData)
      };

      return new Response(JSON.stringify(combinedData), {
        headers: {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*" // Allows your HTML dashboard to read it
        }
      });
    }

    return new Response("Not Found", { status: 404 });
  },

  // 2. Handle Cron Triggers (6 AM and 6 PM automated equipment checks)
  async scheduled(event, env, ctx) {
    console.log("Running scheduled Veeder-Root inventory checks...");

    // Array of your locations and their specific IPs/Ports
    const locations = [
      { id: "Shell", ip: "199.189.242.170", port: 10277 },
      { id: "Exxon", ip: "199.189.242.136", port: 10277 },
      { id: "Xpress", ip: "199.189.242.222", port: 10277 }
    ];
    
    // The command: Control A (Hex 01) + 250 for delivery/inventory reports
    const VEEDER_ROOT_COMMAND = "\x01250\n";
    
    // Loop through all locations to grab inventory via raw TCP socket
    for (const site of locations) {
      try {
        // Open a direct TCP socket to the site controller
        const socket = connect({ hostname: site.ip, port: site.port });
        const writer = socket.writable.getWriter();
        const reader = socket.readable.getReader();
        
        // Send the "Control A 250" command
        const encoder = new TextEncoder();
        await writer.write(encoder.encode(VEEDER_ROOT_COMMAND));
        
        // Read the raw response
        const { value } = await reader.read();
        const decoder = new TextDecoder();
        const rawResponse = decoder.decode(value);
        
        // Close the connection
        await writer.close();
        
        // Store the raw output in your database to be matched with your PDF pricing later
        await env.INVENTORY_DB.put(`current_status_${site.id}`, JSON.stringify({
          timestamp: new Date().toISOString(),
          raw_inventory: rawResponse 
        }));
        
        console.log(`Successfully pulled delivery data for ${site.id}`);
        
      } catch (error) {
        console.error(`Failed to reach ${site.id} equipment on port 10277:`, error);
      }
    }
  }
};
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fuel Pricing & Inventory</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white font-sans antialiased p-6">

    <div class="max-w-md mx-auto">
        <h1 class="text-2xl font-bold mb-6 text-blue-400">Live Inventory Dashboard</h1>
        
        <div id="dashboard-data" class="space-y-6">
            <p class="text-gray-400 text-sm animate-pulse">Fetching latest snapshots from locations...</p>
        </div>
        
        <button onclick="fetchData()" class="mt-8 w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg transition-colors shadow-lg">
            Refresh Data
        </button>
    </div>

    <script>
        // You will replace this with your actual Cloudflare Worker URL once deployed
        const WORKER_API_URL = "https://your-worker-name.your-subdomain.workers.dev/api/inventory-status";

        async function fetchData() {
            const container = document.getElementById('dashboard-data');
            
            try {
                const response = await fetch(WORKER_API_URL);
                const data = await response.json();
                
                container.innerHTML = ''; // Clear loading text

                // Loop through each location in the response
                for (const [locationName, locationData] of Object.entries(data)) {
                    const cleanName = locationName.replace('_', ' ');
                    const timestamp = locationData.timestamp ? new Date(locationData.timestamp).toLocaleTimeString() : 'N/A';
                    
                    // Create a card for each location
                    const card = `
                        <div class="bg-gray-800 rounded-lg p-5 shadow-md border border-gray-700">
                            <div class="flex justify-between items-center border-b border-gray-700 pb-3 mb-3">
                                <h2 class="font-bold text-lg text-gray-100">${cleanName}</h2>
                                <span class="text-xs text-gray-500">Sync: ${timestamp}</span>
                            </div>
                            <div class="text-sm text-gray-300 font-mono overflow-x-auto whitespace-pre-wrap bg-gray-900 p-3 rounded">
                                ${locationData.raw_inventory || 'Awaiting Veeder-Root Data...'}
                            </div>
                        </div>
                    `;
                    container.innerHTML += card;
                }

            } catch (error) {
                container.innerHTML = `<div class="bg-red-900/50 border border-red-500 p-4 rounded text-red-200 text-sm">Error connecting to backend API.</div>`;
            }
        }

        // Auto-fetch on load
        fetchData();
    </script>
</body>
</html>
