import { connect } from 'cloudflare:sockets';

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type",
};

export default {
  // 1. Handle HTTP Requests (Dashboard API & PDF Uploads)
  async fetch(request, env, ctx) {
    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const url = new URL(request.url);

    // Endpoint for HTML Dashboard to fetch latest inventory
    if (url.pathname === "/api/inventory-status" && request.method === "GET") {
      const data = await env.INVENTORY_DB.get("latest_inventory");
      return new Response(data || JSON.stringify({ status: "No data available yet" }), {
        headers: { ...corsHeaders, "Content-Type": "application/json" },
      });
    }

    // Endpoint for Google Apps Script to send PDF metadata
    if (url.pathname === "/upload-pdf" && request.method === "POST") {
      try {
        const payload = await request.json();
        console.log("PDF Upload received:", payload);
        // You can also store this in KV if needed:
        // await env.INVENTORY_DB.put("latest_invoice", JSON.stringify(payload));
        return new Response("PDF received and logged.", { status: 200, headers: corsHeaders });
      } catch (err) {
        return new Response("Invalid JSON", { status: 400, headers: corsHeaders });
      }
    }

    return new Response("Not Found", { status: 404, headers: corsHeaders });
  },

  // 2. Handle Cron Triggers (Veeder-Root TCP Polling)
  async scheduled(event, env, ctx) {
    console.log("Cron triggered. Fetching Veeder-Root data...");
    
    // Replace with your actual gas station static IPs
    const stations = [
      { name: "Shell", ip: "192.168.1.100" },
      { name: "Exxon", ip: "192.168.1.101" },
      { name: "Amoco", ip: "192.168.1.102" }
    ];

    const inventoryResults = {};

    for (const station of stations) {
      try {
        // Connect to Veeder-Root TCP Port 10277
        const socket = connect({ hostname: station.ip, port: 10277 });
        const writer = socket.writable.getWriter();
        const reader = socket.readable.getReader();

        // Send Veeder-Root Inventory Command (I20100 is standard for inventory)
        const command = new TextEncoder().encode("\x01I20100\n");
        await writer.write(command);

        // Read response
        const { value, done } = await reader.read();
        const responseText = new TextDecoder().decode(value);
        
        inventoryResults[station.name] = {
          status: "Success",
          data: responseText,
          timestamp: new Date().toISOString()
        };

        writer.close();
      } catch (error) {
        console.error(`Failed to connect to ${station.name}:`, error.message);
        inventoryResults[station.name] = {
          status: "Error",
          message: "Failed to connect to TLS/TCP socket",
          timestamp: new Date().toISOString()
        };
      }
    }

    // Save results to Cloudflare KV
    await env.INVENTORY_DB.put("latest_inventory", JSON.stringify(inventoryResults));
    console.log("Inventory database updated.");
  }
};
